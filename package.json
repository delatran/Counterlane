{
  "name": "counterlane",
  "version": "0.1.0",
  "description": "Evidence-driven adaptive compute control for Codex across model, reasoning effort, speed tier, topology, and verification.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "counterlane": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    ".agents",
    ".codex-plugin",
    ".mcp.json",
    "deploy",
    "skills/counterlane",
    "scripts/counterlane-doctor.mjs",
    "scripts/demo-judge.mjs",
    "scripts/install-local-plugin.mjs",
    "scripts/public-artifacts.mjs",
    "scripts/release-status.mjs",
    "scripts/source-manifest.mjs",
    "test/fixtures/mock-app-server.mjs",
    "JUDGE_FIXTURE_MANIFEST.json",
    "SOURCE_MANIFEST.sha256",
    "BUILD_WEEK.md",
    "CHANGELOG.md",
    "DEMO.md",
    "DEPENDENCY_INVENTORY.md",
    "SUBMISSION.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "RELEASE_STATUS.json",
    "counterlane.config.example.json",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:test": "tsc -p tsconfig.test.json",
    "test:built": "npm run build:test && node scripts/run-tests.mjs",
    "test": "npm run build && npm run test:built",
    "plugin:validate": "node scripts/validate-plugin.mjs",
    "counterlane:doctor": "node scripts/counterlane-doctor.mjs",
    "demo:judge": "node scripts/demo-judge.mjs",
    "package:judge": "node scripts/package-judge.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:status": "node scripts/release-status.mjs",
    "source-manifest:generate": "node scripts/source-manifest.mjs generate",
    "source-manifest:check": "node scripts/source-manifest.mjs check",
    "check": "npm run typecheck && npm run build && npm run source-manifest:check && npm run plugin:validate && npm run test:built",
    "start": "node dist/cli.js",
    "dev": "npm run build && node dist/cli.js",
    "protocol:generate": "node scripts/generate-codex-protocol.mjs",
    "demo:create": "node scripts/create-demo-repo.mjs",
    "experiment:2x2:plan": "node scripts/experiment-2x2.mjs plan --protocol experiments/work-codex-2x2/protocol.codex-app.json",
    "experiment:2x2:analyze": "node scripts/experiment-2x2.mjs analyze --protocol experiments/work-codex-2x2/protocol.codex-app.json",
    "plugin:install-local": "node scripts/install-local-plugin.mjs"
  },
  "keywords": [
    "codex",
    "openai",
    "model-routing",
    "reasoning-effort",
    "fast-mode",
    "service-tier",
    "coding-agent",
    "counterfactual",
    "verification",
    "llm-router",
    "mcp",
    "codex-plugin",
    "chatgpt-work"
  ],
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.8.3"
  }
}
