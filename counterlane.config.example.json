{
  "version": 1,
  "dataDirectory": ".counterlane",
  "codex": {
    "command": "codex",
    "args": [
      "app-server"
    ],
    "startupTimeoutMs": 15000,
    "requestTimeoutMs": 30000,
    "turnTimeoutMs": 1800000,
    "shutdownTimeoutMs": 5000,
    "experimentalApi": false,
    "approvalPolicy": "never",
    "sandbox": {
      "type": "workspaceWrite",
      "networkAccess": false
    },
    "extraTurnParams": {}
  },
  "routing": {
    "profile": "balanced",
    "static": {
      "family": "sol",
      "effort": "medium",
      "speed": "standard"
    },
    "familyMatchers": {
      "luna": [
        "luna"
      ],
      "terra": [
        "terra"
      ],
      "sol": [
        "sol"
      ]
    },
    "candidateEfforts": [
      "low",
      "medium",
      "high",
      "xhigh",
      "max",
      "ultra"
    ],
    "speed": {
      "enabled": true,
      "candidateTiers": [
        "standard",
        "fast"
      ],
      "defaultTier": "standard",
      "allowUnadvertisedTiers": false,
      "maxUsagePercentForPremium": 45,
      "minimumLatencySensitivityForPremium": 0.38,
      "profiles": {
        "standard": {
          "costMultiplier": 1,
          "latencyMultiplier": 1,
          "premium": false
        },
        "fast": {
          "costMultiplier": 2.5,
          "latencyMultiplier": 0.6666666666666666,
          "premium": true,
          "modelOverrides": [
            {
              "matcher": "gpt-5.4",
              "costMultiplier": 2
            },
            {
              "matcher": "gpt-5.5",
              "costMultiplier": 2.5
            }
          ]
        }
      }
    },
    "reservePercent": 20,
    "enableMax": true,
    "enableUltra": false,
    "maxUsagePercentForMax": 45,
    "maxUsagePercentForUltra": 30,
    "minimumCompletion": {
      "normal": 0.78,
      "elevated": 0.9,
      "critical": 0.97
    },
    "minimumQuality": {
      "normal": 0.78,
      "elevated": 0.9,
      "critical": 0.97
    },
    "costModel": {
      "inputCreditsPerMillionAtLuna": 25,
      "cachedInputCreditsPerMillionAtLuna": 2.5,
      "outputCreditsPerMillionAtLuna": 150,
      "familyWeights": {
        "luna": 1,
        "terra": 2.5,
        "sol": 5,
        "unknown": 5
      }
    },
    "weights": {
      "cost": 0.9,
      "latency": 0.25,
      "quota": 0.8,
      "failure": 2.4,
      "uncertainty": 0.7,
      "switching": 0.1
    }
  },
  "meta": {
    "enabled": true,
    "minimumExactSamples": 4,
    "minimumFallbackSamples": 8,
    "maximumTwinSamplesPerContext": 24,
    "confidenceZ": 1.645,
    "upliftMargin": 0.5,
    "priorStrength": 2,
    "priorStandardDeviation": 25,
    "expectedFutureSimilarTasks": 12,
    "informationValueScale": 0.25,
    "twinCostMultiplier": 1.1,
    "maximumQuotaPressureForTwin": 0.62,
    "maximumUsedPercentForTwin": 55,
    "minimumCriticalVerifierStrength": 0.55
  },
  "twin": {
    "execution": "parallel",
    "preserveWorktrees": "on-failure",
    "maximumDurationMs": 3600000,
    "applyWinnerByDefault": false,
    "requireOriginalStateUnchanged": true,
    "worktreeBaseDirectory": null,
    "dependencyDirectories": ["node_modules"],
    "maximumDependencyFiles": 250000,
    "maximumDependencyBytes": 5000000000
  },
  "verification": {
    "autoDetect": true,
    "requireAtLeastOne": true,
    "failOnNoVerifier": true,
    "requireTaskSpecificCheck": false,
    "defaultTimeoutMs": 600000,
    "maximumOutputBytes": 1000000,
    "commands": [
      {
        "name": "repository-tests",
        "command": [
          "npm",
          "test"
        ],
        "required": true,
        "candidateCodePolicy": "executes-candidate-code",
        "minimumTier": "standard"
      }
    ]
  },
  "telemetry": {
    "enabled": true,
    "includePrompt": false,
    "allowHostLedgerLearning": false,
    "file": "events.jsonl",
    "maximumReadEvents": 5000,
    "maximumReadBytes": 8388608
  },
  "utility": {
    "verifiedSuccessValue": 100,
    "verificationScoreValue": 10,
    "normalizedCreditPenalty": 1,
    "latencyPenaltyPerMinute": 0.2,
    "failedTurnPenalty": 35,
    "detectedVerificationFailurePenalty": 200,
    "practicalEquivalenceMargin": 0.05
  }
}
